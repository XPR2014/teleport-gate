{
	"schemaVersion": 1,
	"id": "teleport-gate",
	"version": "${version}",
	"name": "Teleport Gate",
	"description": "Adds namable teleport blocks for free intra-dimension travel with multiplayer support. Features search bar, teleport cooldown, teleport particles and sound effects; duplicate name check, separate storage for each dimension, automatic timed data saving. Cheats not required.",
	"authors": [
		"Monkey"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/teleportgate",
		"sources": "https://github.com/XPR2014/teleport-gate"
	},
	"license": "MIT",
	"icon": "assets/teleport-gate/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.monkey.teleportgate.TeleportGate"
		],
		"client": [
			"com.monkey.teleportgate.client.TeleportGateClient"
		]
	},
	"mixins": [
		"teleport-gate.mixins.json",
		{
			"config": "teleport-gate.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}